# Providers can be selected independently: ollama or openai-compatible.
RAG_CHAT_PROVIDER=ollama
RAG_EMBEDDING_PROVIDER=ollama

# Free local defaults.
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_CHAT_MODEL=llama3.2:3b
RAG_EMBEDDING_MODEL=embeddinggemma
# Optional Ragas judge; use a model that reliably follows tool schemas.
RAG_EVAL_MODEL=qwen3:8b

# Used only by an openai-compatible provider (LM Studio, LocalAI, etc.).
RAG_OPENAI_BASE_URL=http://localhost:1234/v1
RAG_OPENAI_API_KEY=

# Optional hosted citation audit. Off keeps all inference local.
# Observer mode sends generated claims and their cited excerpts to TypeSafe.
# Repair mode also checks other retrieved excerpts and may replace weak citations.
# Modes: off, observe, repair. Claim text is preserved in repair mode.
RAG_JEV_MODE=off
TYPESAFE_API_KEY=
RAG_JEV_MODEL=jev-1.13.0
# Total budget per question part, not per individual claim.
RAG_JEV_TIMEOUT=5
# Experimental policy threshold; calibrate against reviewed claims.
RAG_JEV_THRESHOLD=0.90

# Retrieval and storage.
RAG_DATA_DIR=data/qdrant
RAG_COLLECTION=documents
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.15
RAG_MAX_UPLOAD_MB=10
RAG_REQUEST_TIMEOUT=120

